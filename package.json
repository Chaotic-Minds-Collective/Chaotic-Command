{
  "name": "chaotic-command",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/command/server.mjs",
    "start:bot": "node --env-file-if-exists=.env apps/discord-bot/index.mjs",
    "dev": "node --watch --env-file-if-exists=.env apps/command/server.mjs",
    "dev:bot": "node --watch --env-file-if-exists=.env apps/discord-bot/index.mjs",
    "test": "node --test apps/command/test/*.test.mjs apps/discord-bot/test/*.test.mjs",
    "check": "node --check apps/command/server.mjs && node --check apps/command/core.mjs && node --check apps/command/web/app.js && node --check apps/discord-bot/index.mjs",
    "migrate": "node --env-file-if-exists=.env apps/command/db/migrate.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
