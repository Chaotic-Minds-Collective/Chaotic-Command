# Node 24+. Never use a VITE_ prefix for these secrets.
PORT=3000
APP_ORIGIN=http://localhost:3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# SQLite contains encrypted sessions and server notes. Keep private and back up.
DATA_DIR=.data
# For HTTPS deployment set NODE_ENV=production and APP_ORIGIN=https://your-domain
NODE_ENV=development
